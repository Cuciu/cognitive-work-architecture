 ============================================================
# env.yaml.example — Sales Agent Environment Configuration
# ============================================================
# Copy this file to env.yaml and fill in your values.
# Do NOT commit env.yaml to version control.
#
#   cp env.yaml.example env.yaml
# ============================================================

# --- GCP Project ---
GCP_PROJECT: your-gcp-project-id
REGION: global                          # Vertex AI region (global recommended)
MODEL: gemini-3.5-flash-lite            # Router + agent model

# --- Vector Retrieval (Option B architecture) ---
EMBED_MODEL: text-embedding-005         # Vertex embedding model
VECTOR_COLLECTION: KBVectors            # Firestore collection for vector chunks
RETRIEVE_TOP_K: "4"                     # Number of chunks retrieved per query
KB_DIR: knowledge                       # Path to knowledge base markdown files

# --- Agent Runtime ---
CONSULTATION_URL: https://your-domain.com/booking   # CTA link for lead capture
ALLOWED_ORIGIN: https://your-domain.com              # CORS origin for the widget
